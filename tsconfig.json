{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "module": "nodenext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    // TS 6.0 の既定。段階導入(#2379)を終えたので個別フラグは畳んである
    "strict": true,
    "sourceMap": true,
    // TS 6.0 から rootDir の暗黙推論が廃止(TS5011)。include が vite.*.config.ts
    // 等リポジトリ直下も含むため "." を明示する
    "rootDir": ".",
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "e2e/**/*", "*.config.ts"]
}
